{
  "name": "zinnias-ciao",
  "version": "0.59.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "bunx wrangler dev --env dev --local",
    "build": "worker-build --release workers/ssr",
    "migrate:dev": "bunx wrangler d1 migrations apply zinnias-ciao-dev --local --env dev",
    "migrate:staging": "bunx wrangler d1 migrations apply zinnias-ciao-staging --remote --env staging --config wrangler.staging.local.toml",
    "migrate:prod": "bunx wrangler d1 migrations apply zinnias-ciao --remote --env production --config wrangler.production.local.toml",
    "bootstrap:staging": "node scripts/bootstrap-cloudflare.mjs --target staging --config wrangler.staging.local.toml",
    "bootstrap:production": "node scripts/bootstrap-cloudflare.mjs --target production --config wrangler.production.local.toml",
    "recover:community-access": "node scripts/recover-community-access.mjs",
    "test": "cargo test -p zinnias-ciao-domain -p zinnias-ciao-contracts -p zinnias-ciao-ssr",
    "lint": "cargo clippy -p zinnias-ciao-domain -p zinnias-ciao-contracts -- -D warnings",
    "fmt": "cargo fmt --all -- --check",
    "reset:dev": "node scripts/setup.mjs --reset",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:recurrence": "node scripts/smoke/recurrence-v2.mjs",
    "smoke:event-copy": "node scripts/smoke/event-copy.mjs",
    "smoke:invite": "node scripts/smoke/invite-redemption.mjs",
    "test:audit-assertion": "node scripts/test-audit-assertion.mjs",
    "test:audit-atomicity": "node scripts/test-audit-atomicity.mjs",
    "test:audit-boundaries": "node scripts/test-audit-boundaries.mjs",
    "test:audit-class-a-failures": "node scripts/test-audit-class-a-failures.mjs",
    "test:audit-migration": "node scripts/test-audit-migration.mjs",
    "test:local-secret-setup": "node scripts/test-local-secret-setup.mjs",
    "test:bootstrap-safety": "node scripts/test-bootstrap-cloudflare.mjs",
    "test:hmac-pepper-configuration": "node scripts/test-hmac-pepper-configuration.mjs",
    "smoke:display-name": "node scripts/smoke/self-display-name-editing.mjs",
    "smoke:matrix": "node scripts/smoke/monthly-attendance-matrix.mjs",
    "smoke:matrix-csv": "node scripts/smoke/calendar-matrix-csv-export.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
